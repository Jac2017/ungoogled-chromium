      "frame":                         [-1, -1, -1],
      "frame_inactive":                [-1, -1, 0.8],
      "background_tab":                [0.58, 0.2, 0.6]
    },

    "properties": {
      "ntp_background_alignment": "center",
      "ntp_logo_alternate": 1
    }
  },

  "icons": {
    "16": "icons/glass-theme-16.png",
    "128": "icons/glass-theme-128.png"
