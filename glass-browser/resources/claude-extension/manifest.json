{
  "manifest_version": 3,
  "name": "Claude for Glass Browser",
  "version": "1.0.0",
  "description": "AI assistant built into Glass Browser. Organize tabs, summarize pages, compare products, and research topics.",
  "author": "Glass Browser Team",

  "permissions": [
    "tabs",
    "tabGroups",
    "activeTab",
    "storage",
    "sidePanel"
  ],

  "host_permissions": [
    "https://api.anthropic.com/*"
  ],

  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },

  "side_panel": {
    "default_path": "claude-panel.html"
  },

  "action": {
    "default_title": "Claude AI",
    "default_icon": {
      "16": "icons/claude-16.png",
      "32": "icons/claude-32.png",
      "48": "icons/claude-48.png",
      "128": "icons/claude-128.png"
    }
  },

  "icons": {
    "16": "icons/claude-16.png",
    "32": "icons/claude-32.png",
    "48": "icons/claude-48.png",
    "128": "icons/claude-128.png"
  },

  "commands": {
    "toggle-claude-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Toggle Claude AI panel"
    },
    "organize-tabs": {
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "Organize tabs with Claude"
    }
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://api.anthropic.com;"
  },

  "minimum_chrome_version": "120"
}
