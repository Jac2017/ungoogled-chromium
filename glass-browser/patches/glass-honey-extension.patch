+// Registers Honey as a default extension in Glass Browser.
+// The extension is installed on first run and kept up-to-date via
+// the standard Chrome extension update mechanism.
+//
+// Security considerations:
+//   - Extension is loaded from the Chrome Web Store with signature verification
+//   - User can disable/remove the extension at any time
+//   - Extension permissions are reviewed and documented
+//   - No special privileges beyond what the extension manifest declares
+void RegisterGlassDefaultExtensions(ExtensionRegistry* registry) {
+  // Register Honey for pre-installation
+  ExternalProviderImpl::RegisterExternalExtension(
+      registry,
+      kHoneyExtensionId,
+      base::Version("1.0.0"),
+      kHoneyUpdateUrl,
+      Manifest::EXTERNAL_POLICY_DOWNLOAD,
+      Extension::FROM_WEBSTORE);
+}
