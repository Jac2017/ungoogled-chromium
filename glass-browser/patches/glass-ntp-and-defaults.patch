--- a/chrome/browser/search/search_engine_choice_service.cc
+++ b/chrome/browser/search/search_engine_choice_service.cc
@@ -1,3 +1,4 @@
+// Glass Browser: Set Bing as default search engine
 // Copyright 2023 The Chromium Authors
 // Use of this source code is governed by a BSD-style license that can be
 // found in the LICENSE file.
@@ -20,6 +21,18 @@ void SearchEngineChoiceService::SetDefaultSearchEngine() {
+  // Glass Browser: Use Bing as default search engine when the
+  // --glass-default-bing flag is present (set by glass_flags.gn).
+  // This runs before the normal engine-choice flow so users still
+  // see Bing pre-selected but can change it in Settings.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("glass-default-bing")) {
+    TemplateURLData data;
+    data.SetShortName(u"Bing");
+    data.SetKeyword(u"bing.com");
+    data.SetURL("https://www.bing.com/search?q={searchTerms}");
+    data.suggestions_url = "https://www.bing.com/osjson.aspx?query={searchTerms}";
+    data.favicon_url = GURL("https://www.bing.com/favicon.ico");
+    template_url_service->SetUserSelectedDefaultSearchProvider(
+        template_url_service->Add(std::make_unique<TemplateURL>(data)));
+    return;
+  }
+
   // If the user hasn't made a search engine choice yet, show the
   // search engine choice dialog.

