 NewTabUI::NewTabUI(content::WebUI* web_ui) : content::WebUIController(web_ui) {
+  // Glass Browser: Load custom New Tab Page with glass morphism UI
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("glass-ntp")) {
+    content::WebUIDataSource* source =
+        content::WebUIDataSource::CreateAndAdd(
+            web_ui->GetWebContents()->GetBrowserContext(), "glass-newtab");
+    source->AddResourcePath("", IDR_GLASS_NEWTAB_HTML);
+    source->AddResourcePath("newtab.css", IDR_GLASS_NEWTAB_CSS);
+    source->AddResourcePath("newtab.js", IDR_GLASS_NEWTAB_JS);
+    return;
+  }
