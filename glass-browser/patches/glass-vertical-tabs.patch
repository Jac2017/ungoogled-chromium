+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_GLASS_VERTICAL_TAB_STRIP_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_GLASS_VERTICAL_TAB_STRIP_H_
+
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/ui/views/tabs/tab_strip.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/controls/webview/webview.h"
+
+namespace glass {
+
+// GlassVerticalTabStrip replaces the default horizontal TabStrip with a
+// vertical sidebar that supports:
+//   - Collapsed state: shows only favicons (52px wide)
+//   - Expanded state: shows full tab info (280px wide)
+//   - Hover-to-expand interaction
+//   - Claude AI-organized tab groups
+//   - Drag-and-drop tab reordering
+//
+// The sidebar is implemented as a WebView loading the Glass Browser's
+// vertical-tabs.html resource, which communicates with the native tab
+// model via chrome.tabs API extensions.
+//
+// Design rationale (Jony Ive / Dieter Rams):
+//   - Vertical tabs maximize horizontal content space
+//   - Collapse/expand respects user attention — show less when not needed
+//   - Glass morphism creates depth without visual weight
+//   - Groups reduce cognitive load by clustering related tabs
+
+class GlassVerticalTabStrip : public views::View {
+ public:
+  static constexpr int kCollapsedWidth = 52;
+  static constexpr int kExpandedWidth = 280;
+  static constexpr int kAnimationDurationMs = 280;
+
+  explicit GlassVerticalTabStrip(Browser* browser);
+  ~GlassVerticalTabStrip() override;
+
+  GlassVerticalTabStrip(const GlassVerticalTabStrip&) = delete;
+  GlassVerticalTabStrip& operator=(const GlassVerticalTabStrip&) = delete;
+
+  // views::View overrides
+  gfx::Size CalculatePreferredSize() const override;
+  void Layout() override;
+  void OnMouseEntered(const ui::MouseEvent& event) override;
+  void OnMouseExited(const ui::MouseEvent& event) override;
+
+  // Expand/collapse the sidebar
+  void SetExpanded(bool expanded);
+  bool IsExpanded() const { return is_expanded_; }
+
+  // Toggle Claude AI panel
+  void ToggleClaudePanel();
+  bool IsClaudePanelOpen() const { return claude_panel_open_; }
+
+ private:
+  // Animation callback
+  void AnimateWidth(int target_width);
+
+  raw_ptr<Browser> browser_;
+  raw_ptr<views::WebView> webview_;
+  bool is_expanded_ = false;
+  bool claude_panel_open_ = false;
+  int current_width_ = kCollapsedWidth;
+};
+
+// GlassClaudePanel provides the right-side panel for Claude AI integration.
+// Loads claude-panel.html and communicates with the Anthropic API via
+// a background service worker.
+
+class GlassClaudePanel : public views::View {
+ public:
+  static constexpr int kPanelWidth = 360;
+
+  explicit GlassClaudePanel(Browser* browser);
+  ~GlassClaudePanel() override;
+
+  GlassClaudePanel(const GlassClaudePanel&) = delete;
+  GlassClaudePanel& operator=(const GlassClaudePanel&) = delete;
+
+  gfx::Size CalculatePreferredSize() const override;
+  void Layout() override;
+
+  void Show();
+  void Hide();
+  bool IsVisible() const { return is_visible_; }
+
+ private:
+  raw_ptr<Browser> browser_;
+  raw_ptr<views::WebView> webview_;
+  bool is_visible_ = false;
+};
+
+}  // namespace glass
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_GLASS_VERTICAL_TAB_STRIP_H_
