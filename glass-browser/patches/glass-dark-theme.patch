 void AddChromeColorMixer(ui::ColorProvider* provider,
                          const ui::ColorProviderKey& key) {
+  // Glass Browser dark theme overrides
+  // Apply translucent dark surfaces across all Chrome UI
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("glass-theme")) {
+    ui::ColorMixer& mixer = provider->AddMixer();
+
+    // Toolbar & frame
+    mixer[kColorToolbar] = {SkColorSetARGB(0xD1, 0x30, 0x30, 0x32)};
+    mixer[kColorToolbarText] = {SkColorSetARGB(0xEB, 0xFF, 0xFF, 0xFF)};
+    mixer[kColorFrameActive] = {SkColorSetARGB(0xF2, 0x00, 0x00, 0x00)};
+    mixer[kColorFrameInactive] = {SkColorSetARGB(0xF2, 0x00, 0x00, 0x00)};
+
+    // Omnibox
+    mixer[kColorOmniboxBackground] = {SkColorSetARGB(0xB8, 0x1C, 0x1C, 0x1E)};
+    mixer[kColorOmniboxText] = {SkColorSetARGB(0xEB, 0xFF, 0xFF, 0xFF)};
+    mixer[kColorOmniboxResultsBackground] = {SkColorSetARGB(0xE0, 0x3A, 0x3A, 0x3C)};
+
+    // Tab strip (hidden, but needed for compatibility)
+    mixer[kColorTabBackgroundActiveFrameActive] = {SkColorSetARGB(0xC7, 0x26, 0x26, 0x28)};
+    mixer[kColorTabForegroundActiveFrameActive] = {SkColorSetARGB(0xEB, 0xFF, 0xFF, 0xFF)};
+
+    // Bookmarks
+    mixer[kColorBookmarkBarBackground] = {SkColorSetARGB(0xC7, 0x26, 0x26, 0x28)};
+    mixer[kColorBookmarkBarForeground] = {SkColorSetARGB(0x8C, 0xFF, 0xFF, 0xFF)};
+    return;
+  }
+
   // Original Chromium color mixing logic follows...
