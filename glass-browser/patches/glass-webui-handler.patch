+// Copyright 2026 Glass Browser Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license.
+
+#include "chrome/browser/ui/webui/glass/glass_browser_ui.h"
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/common/webui_url_constants.h"
+#include "chrome/grit/browser_resources.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+
+namespace glass {
+
+// ---------- GlassNewTabUI ----------
+// Serves chrome://glass-newtab
+
+GlassNewTabUI::GlassNewTabUI(content::WebUI* web_ui)
+    : WebUIController(web_ui) {
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      web_ui->GetWebContents()->GetBrowserContext(), "glass-newtab");
+
+  // New Tab Page resources
+  source->AddResourcePath("", IDR_GLASS_NEWTAB_HTML);
+  source->AddResourcePath("newtab.css", IDR_GLASS_NEWTAB_CSS);
+  source->AddResourcePath("newtab.js", IDR_GLASS_NEWTAB_JS);
+
+  // Content Security Policy
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ScriptSrc,
+      "script-src 'self';");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::StyleSrc,
+      "style-src 'self' 'unsafe-inline';");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ImgSrc,
+      "img-src 'self' https: data:;");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ConnectSrc,
+      "connect-src 'self' https://api.bing.microsoft.com;");
+}
+
+// ---------- GlassBrowserUI ----------
+// Serves chrome://glass-browser/*
+
+GlassBrowserUI::GlassBrowserUI(content::WebUI* web_ui)
+    : WebUIController(web_ui) {
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      web_ui->GetWebContents()->GetBrowserContext(), "glass-browser");
+
+  // Sidebar resources
+  source->AddResourcePath("sidebar/vertical-tabs.html",
+                          IDR_GLASS_VERTICAL_TABS_HTML);
+  source->AddResourcePath("sidebar/vertical-tabs.css",
+                          IDR_GLASS_VERTICAL_TABS_CSS);
+  source->AddResourcePath("sidebar/vertical-tabs.js",
+                          IDR_GLASS_VERTICAL_TABS_JS);
+  source->AddResourcePath("sidebar/claude-panel.html",
+                          IDR_GLASS_CLAUDE_PANEL_HTML);
+  source->AddResourcePath("sidebar/claude-panel.css",
+                          IDR_GLASS_CLAUDE_PANEL_CSS);
+  source->AddResourcePath("sidebar/claude-panel.js",
+                          IDR_GLASS_CLAUDE_PANEL_JS);
+
+  // Theme resources
+  source->AddResourcePath("theme/glass-dark.css",
+                          IDR_GLASS_DARK_THEME_CSS);
+
+  // CSP for sidebar panels
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ScriptSrc,
+      "script-src 'self';");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ConnectSrc,
+      "connect-src 'self' https://api.anthropic.com;");
+}
+
+}  // namespace glass
+
