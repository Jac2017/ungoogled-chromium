+#ifndef CHROME_BROWSER_UI_WEBUI_GLASS_GLASS_BROWSER_UI_H_
+#define CHROME_BROWSER_UI_WEBUI_GLASS_GLASS_BROWSER_UI_H_
+
+#include "content/public/browser/web_ui_controller.h"
+#include "content/public/browser/web_ui_data_source.h"
+
+namespace glass {
+
+// GlassBrowserUI serves the chrome://glass-browser/* and
+// chrome://glass-newtab URLs. It registers all Glass Browser
+// resources (NTP, sidebar, theme) with Chromium's WebUI system.
+//
+// URL mapping:
+//   chrome://glass-newtab        → newtab.html
+//   chrome://glass-browser/sidebar/vertical-tabs.html
+//   chrome://glass-browser/sidebar/claude-panel.html
+//   chrome://glass-browser/theme/glass-dark.css
+
+class GlassNewTabUI : public content::WebUIController {
+ public:
+  explicit GlassNewTabUI(content::WebUI* web_ui);
+  ~GlassNewTabUI() override = default;
+
+  GlassNewTabUI(const GlassNewTabUI&) = delete;
+  GlassNewTabUI& operator=(const GlassNewTabUI&) = delete;
+};
+
+class GlassBrowserUI : public content::WebUIController {
+ public:
+  explicit GlassBrowserUI(content::WebUI* web_ui);
+  ~GlassBrowserUI() override = default;
+
+  GlassBrowserUI(const GlassBrowserUI&) = delete;
+  GlassBrowserUI& operator=(const GlassBrowserUI&) = delete;
+};
+
+}  // namespace glass
+
+#endif  // CHROME_BROWSER_UI_WEBUI_GLASS_GLASS_BROWSER_UI_H_
+
