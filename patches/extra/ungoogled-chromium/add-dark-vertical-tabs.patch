+
+// VerticalTabStrip provides a dark-themed vertical tab sidebar with circular
+// favicon indicators that expand on hover to reveal tab titles. Styled after
+// the 1980s NASA "worm" logotype aesthetic: geometric rounded sans-serif,
+// wide letter-spacing, deep-space dark palette with NASA worm red accents.
+class VerticalTabStrip : public views::View,
+                         public TabStripModelObserver,
+                         public gfx::AnimationDelegate {
+  METADATA_HEADER(VerticalTabStrip, views::View)
+
+ public:
+  explicit VerticalTabStrip(Browser* browser);
+  ~VerticalTabStrip() override;
+
+  VerticalTabStrip(const VerticalTabStrip&) = delete;
+  VerticalTabStrip& operator=(const VerticalTabStrip&) = delete;
+
+  static constexpr int kCollapsedWidth = 52;
+  static constexpr int kExpandedWidth = 260;
+
+  // Returns the current animated width between collapsed and expanded.
+  int GetCurrentWidth() const;
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  void OnPaint(gfx::Canvas* canvas) override;
+  void OnMouseEntered(const ui::MouseEvent& event) override;
+  void OnMouseExited(const ui::MouseEvent& event) override;
+  bool OnMousePressed(const ui::MouseEvent& event) override;
+  void Layout(PassKey) override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void TabChangedAt(content::WebContents* contents,
+                    int model_index,
+                    TabChangeType change_type) override;
+
+  // gfx::AnimationDelegate:
+  void AnimationProgressed(const gfx::Animation* animation) override;
+  void AnimationEnded(const gfx::Animation* animation) override;
+
+ private:
+  class TabItem;
+
+  void RebuildTabList();
+
+  raw_ptr<Browser> browser_;
+  raw_ptr<TabStripModel> model_;
+  raw_ptr<views::ScrollView> scroll_view_ = nullptr;
+  raw_ptr<views::View> tab_container_ = nullptr;
+  raw_ptr<views::Label> tab_count_label_ = nullptr;
+
+  gfx::SlideAnimation expand_animation_{this};
+  bool is_expanded_ = false;
+
+  std::vector<raw_ptr<TabItem>> tab_items_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_TAB_STRIP_H_
